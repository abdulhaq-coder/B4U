datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  OWNER
  STAFF
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SocialProvider {
  GOOGLE
  APPLE
}

enum MediaPurpose {
  AVATAR
  BRAND_LOGO
  BRANCH_IMAGE
  SERVICE_IMAGE
}

enum BranchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum SalonType {
  LADIES
  GENTS
  UNISEX
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  fullName        String
  passwordHash    String?
  role            Role
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime
  termsVersion    String

  dateOfBirth        DateTime? @db.Date
  phone              String?
  gender             Gender?
  countryCode        String?   @db.Char(2)
  cityId             String?
  city               City?     @relation(fields: [cityId], references: [id])
  profileCompletedAt DateTime?

  avatarId String?     @unique
  avatar   MediaAsset? @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  socialAccounts   SocialAccount[]
  mediaAssets      MediaAsset[]          @relation("MediaOwner")
  brand            Brand?
  reviewedBranches Branch[]              @relation("BranchReviewer")
  branchHistory    BranchStatusHistory[] @relation("BranchHistoryActor")

  @@index([cityId])
  @@map("users")
}

model SocialAccount {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       SocialProvider
  providerUserId String
  email          String?
  createdAt      DateTime       @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model City {
  id          String   @id @default(uuid())
  name        String
  province    String
  countryCode String   @default("PK") @db.Char(2)
  isActive    Boolean  @default(true)
  users       User[]
  branches    Branch[]

  @@unique([countryCode, name])
  @@map("cities")
}

model OtpCode {
  id         String     @id @default(uuid())
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose, createdAt])
  @@map("otp_codes")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model MediaAsset {
  id        String       @id @default(uuid())
  ownerId   String
  owner     User         @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  purpose   MediaPurpose
  key       String       @unique
  width     Int
  height    Int
  sizeBytes Int
  usedBy    String? // "USER:<id>", "BRANCH:<id>" ... null = abhi kahin lagi nahi
  createdAt DateTime     @default(now())

  avatarOf    User?        @relation("UserAvatar")
  brandLogoOf Brand?       @relation("BrandLogo")
  branchImage BranchImage? @relation("BranchImageMedia")

  @@index([ownerId, usedBy])
  @@map("media_assets")
}

model Brand {
  id          String      @id @default(uuid())
  ownerId     String      @unique
  owner       User        @relation(fields: [ownerId], references: [id])
  name        String
  bio         String?
  logoId      String?     @unique
  logo        MediaAsset? @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)
  verifiedAt  DateTime? // pehli branch approve hone par
  isTrusted   Boolean     @default(false) // true ho to naye branches khud approve
  branchLimit Int         @default(5)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  branches    Branch[]

  @@map("brands")
}

model Branch {
  id               String       @id @default(uuid())
  brandId          String
  brand            Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name             String? // "Safoora"; single salon ho to null
  phone            String
  addressLine      String
  cityId           String
  city             City         @relation(fields: [cityId], references: [id])
  latitude         Float?
  longitude        Float?
  type             SalonType
  timezone         String       @default("Asia/Karachi")
  status           BranchStatus @default(DRAFT)
  rejectionReason  String?
  step1CompletedAt DateTime?
  step2CompletedAt DateTime?
  step3CompletedAt DateTime?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?        @relation("BranchReviewer", fields: [reviewedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  images  BranchImage[]
  hours   BranchHours[]
  history BranchStatusHistory[]

  @@index([brandId])
  @@index([cityId, status])
  @@index([status, submittedAt])
  @@map("branches")
}

model BranchImage {
  id        String     @id @default(uuid())
  branchId  String
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  mediaId   String     @unique
  media     MediaAsset @relation("BranchImageMedia", fields: [mediaId], references: [id])
  sortOrder Int // 0 = cover

  @@unique([branchId, sortOrder])
  @@map("branch_images")
}

model BranchHours {
  id          String  @id @default(uuid())
  branchId    String
  branch      Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  day         Weekday
  opensAtMin  Int // raat 12 se minutes (10:00 = 600)
  closesAtMin Int // din band ho to is din ki koi row nahi

  @@index([branchId, day])
  @@map("branch_hours")
}

model BranchStatusHistory {
  id         String        @id @default(uuid())
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fromStatus BranchStatus?
  toStatus   BranchStatus
  byUserId   String?
  byUser     User?         @relation("BranchHistoryActor", fields: [byUserId], references: [id])
  reason     String?
  createdAt  DateTime      @default(now())

  @@index([branchId, createdAt])
  @@map("branch_status_history")
}
